DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens completas (com http/https e porta), separadas por vírgula.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://localhost:8000,http://127.0.0.1:8000,https://127.0.0.1:8000
CELERIS_SECURE_SSL_REDIRECT=False
CELERIS_SESSION_COOKIE_SECURE=False
CELERIS_CSRF_COOKIE_SECURE=False
CELERIS_SECURE_HSTS_SECONDS=0
CELERIS_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
CELERIS_SECURE_HSTS_PRELOAD=False
# Ative apenas quando o proxy reverso sobrescrever X-Forwarded-Proto.
CELERIS_TRUST_PROXY_SSL_HEADER=False
# Porta publicada pelo GitHub Codespaces (padrão: 8000).
CELERIS_CODESPACE_PORT=8000
CELERIS_DB_ENGINE=sqlite
CELERIS_DB_NAME=db.sqlite3
CELERIS_TIME_ZONE=America/Sao_Paulo
